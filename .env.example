# AURA Mars — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB
# CHROMA_DB_PATH is deliberately left unset by default: src/config.py's
# own fallback already resolves it to an absolute, project-root-anchored
# path, which works regardless of the directory you launch Streamlit
# from. Only set this if you specifically want the database stored
# somewhere else — and use an absolute path if you do, since a relative
# one resolves against wherever the process happens to be started from,
# not this project's root.
# CHROMA_DB_PATH=/absolute/path/to/your/chroma_db
CHROMA_COLLECTION_NAME=aura_mars_docs

# Retrieval Settings
RETRIEVAL_TOP_K=5

# Generation Settings
# 2 is the default (lowered from 4) since the structured answer prompt
# produces much longer output per run on CPU-only Ollama. Raise this if
# you have GPU inference and want more robust consistency scoring.
GENERATION_RUNS=2

# Chunk Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50
